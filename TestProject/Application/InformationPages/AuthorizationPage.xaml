<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestProject.AuthorizationPage"
             Title="Авторизация">

    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1A}">
        <!-- Фон с размытием -->
        <Image Source="gradientfive.jpg" 
               x:Name="Background"
               Aspect="AspectFill" 
               Opacity="0.3"
               Grid.RowSpan="2">
        </Image>

                <!-- Заголовок -->
                <StackLayout Spacing="0" Margin="25,10,0,0" HorizontalOptions="Start">
                    <Label Text="Мы вас ждали, путник..." 
                           x:Name="TitlePage"
                           FontAttributes="Bold" 
                           FontSize="28"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <Label Text="Управление вашим аккаунтом" 
                           FontSize="16"
                           TextColor="Gray"/>
                    
                </StackLayout>
        <!-- Основной контент -->
        <ScrollView Grid.Row="1" Padding="20" Margin="0,100,0,0">
            <StackLayout Spacing="30">

                <!-- Форма входа -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                        StrokeThickness="1"
                         x:Name="EntranceBorder"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}"
                        Padding="25"
                        VerticalOptions="Center">

                    <StackLayout Spacing="25">
                        <StackLayout Spacing="5">
                            <Label Text="Вход в аккаунт" 
                                   FontAttributes="Bold" 
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                            <Label Text="Станьте нашим дорогим гостем" 
                                   FontSize="14"
                                   TextColor="Gray"/>
                        </StackLayout>

                        <!-- Поле email -->
                        <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}">
                            <Entry Placeholder="Email" 
                                   x:Name="EmailEntry"
                                   Keyboard="Email"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="Gray"
                                   ClearButtonVisibility="WhileEditing"/>
                        </Border>

                        <!-- Поле пароля -->
                        <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}">
                            <Entry Placeholder="Пароль" 
                                   x:Name="PasswordEntry"
                                   IsPassword="True"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="Gray"/>
                        </Border>

                        <!-- Кнопка восстановления пароля -->
                        <Label Text="Забыли пароль?" 
                               FontSize="14"
                               TextColor="#4285F4"
                               HorizontalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Кнопка входа -->
                        <Button Text="Войти" 
                                BackgroundColor="#4285F4"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="50"
                                FontSize="16"
                                Clicked="OnEntranceClicked"/>

                        <StackLayout x:Name="GoogleAuth" Orientation="Horizontal" HorizontalOptions="CenterAndExpand">

                            <Label Text="Или авторизуйтесь через" FontSize="14"/>
                            <Image Source="googleicon" WidthRequest="30" HeightRequest="30" Margin="10,-6,0,0"></Image>

                        </StackLayout>
                    </StackLayout>
                   
                </Border>

                <!-- Переход к регистрации -->
                <StackLayout Orientation="Horizontal" 
                             HorizontalOptions="Center"
                             x:Name="GoRegistr"
                             Spacing="5">
                    <Label Text="Нет аккаунта?" 
                           FontSize="14"
                           TextColor="Gray"/>

                    <Label Text="Зарегистрироваться" 
                           FontSize="14"
                           TextColor="#4285F4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
                
            <!-- Форма регистрации (изначально скрыта) -->
            <StackLayout x:Name="CreateLayout" 
              IsVisible="False"
              Grid.RowSpan="2">
                <!-- Аналогичная форма регистрации -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
   StrokeThickness="1"
   StrokeShape="RoundRectangle 20"
   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}"
   Padding="25"
   VerticalOptions="Center">

                    <StackLayout Spacing="25">
                        <StackLayout Spacing="5">
                            <Label Text="Создание аккаунта" 
              FontAttributes="Bold" 
              FontSize="22"
              TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                            <Label Text="Станьте нашим дорогим гостем" 
              FontSize="14"
              TextColor="Gray"/>
                        </StackLayout>

                        <!-- Поле email -->
                        <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
           StrokeThickness="1"
           StrokeShape="RoundRectangle 10"
           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}">
                            <Entry Placeholder="Email" 
              x:Name="EmailEEntry"
              Keyboard="Email"
              TextColor="{AppThemeBinding Light=Black, Dark=White}"
              PlaceholderColor="Gray"
              ClearButtonVisibility="WhileEditing"/>
                        </Border>

                        <!-- Поле NickName -->
                        <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
           StrokeThickness="1"
           StrokeShape="RoundRectangle 10"
           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}">
                            <Entry Placeholder="Пользовательский nick name" 
              x:Name="NickNameEntry"
              TextColor="{AppThemeBinding Light=Black, Dark=White}"
              PlaceholderColor="Gray"
              ClearButtonVisibility="WhileEditing"/>
                        </Border>

                        <!-- Поле пароля -->
                        <Border Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
           StrokeThickness="1"
           StrokeShape="RoundRectangle 10"
           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}">
                            <Entry Placeholder="Пароль" 
              x:Name="PasswordEEntry"
              IsPassword="True"
              TextColor="{AppThemeBinding Light=Black, Dark=White}"
              PlaceholderColor="Gray"/>
                        </Border>


                        <!-- Кнопка входа -->
                        <Button Text="Создать аккаунт" 
           BackgroundColor="#4285F4"
           TextColor="White"
           CornerRadius="10"
           HeightRequest="50"
           FontSize="16"
           Clicked="OnAddClicked"/>
                    </StackLayout>
                </Border>
            </StackLayout>
                <!-- Переход к регистрации -->
                <StackLayout Orientation="Horizontal" 
               HorizontalOptions="Center"
                             IsVisible="False"
               x:Name="GoEntrance"
               Spacing="5">
                    <Label Text="Вернуться к входу в аккаунт" 
             FontSize="14"
             TextColor="#4285F4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEntranceTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </StackLayout>
            
        </ScrollView>

      
    </Grid>
</ContentPage>