<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestProject.MainPage"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             Title="Cine Chronicle">

    <ContentPage.Resources>
        <!-- Общие стили -->
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="25,0,0,0"/>
        </Style>

        <Style x:Key="SectionSubtitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="25,0,0,-25"/>
        </Style>

        <Style x:Key="ContentCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Black"/>
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 30"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Black}}" 
                            Opacity="0.7" Radius="20" Offset="0,0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Page.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Black}}" 
                              StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}"/>
    </Page.Behaviors>

    <Grid BackgroundColor="Transparent">
        <!-- Фоновое изображение -->
        <Image x:Name="Background" Source="gradientseven.jpg" Aspect="AspectFill" Opacity="0.5"/>

        <!-- Основная область контента -->
        <ScrollView>
            <StackLayout>
                <!-- Оффлайн баннер -->
                <Border x:Name="IsDeviceOfflineBorder"
                        Opacity="1"
                        Background="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"
                        Stroke="{AppThemeBinding Light=#FF4444, Dark=#FF6666}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        Padding="15"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="20"
                        HeightRequest="100"
                        MinimumWidthRequest="300">

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
                            <Label x:Name="IsDeviceOfflineLabel1"
                                   Text="Отсутствует интернет соединение"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#EEEEEE}"/>
                        </HorizontalStackLayout>

                        <Label Grid.Row="1"
                               x:Name="IsDeviceOfflineLabel2"
                               Text="Работаем в оффлайн-режиме"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                               Margin="45,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Недавно просмотренные -->
                <StackLayout x:Name="CWatched">
                <Label Text="Недавно просмотренные" Style="{StaticResource SectionTitleStyle}"/>
                <Label Text="Контент, который вы обновляли либо меняли серию" Style="{StaticResource SectionSubtitleStyle}"/>

                <CollectionView x:Name="RecentlyChangeCarouselView"
                               ItemsSource="{Binding ContentChange}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedItem}"
                                 Margin="0,50,0,50"
                                VerticalOptions="Center"
                                HorizontalOptions="StartAndExpand">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" Span="2"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource ContentCardStyle}"
                                        Margin="25,10,25,10"
                                        HeightRequest="250"
                                        WidthRequest="200">
                                    <Grid RowDefinitions=".2*,.6*,.2*">
                                        <Image Aspect="Fill" Source="{Binding Image}" Grid.RowSpan="3"/>
                                        <RoundRectangle Grid.RowSpan="3"
                                                        CornerRadius="30"
                                                        HeightRequest="250"
                                                        WidthRequest="200"
                                                        Opacity=".7">
                                            <RoundRectangle.Fill>
                                                <LinearGradientBrush EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="Transparent"/>
                                                    <GradientStop Offset="1" Color="#030005"/>
                                                </LinearGradientBrush>
                                            </RoundRectangle.Fill>
                                        </RoundRectangle>

                                        <VerticalStackLayout Grid.Row="2" Margin="20,-10,0,0">
                                            <Label TextColor="White" Text="{Binding Type, StringFormat='Тип: {0}'}" FontSize="12"/>
                                            <Label FontSize="16" Text="{Binding Title}" TextColor="White"/>
                                            <Label FontSize="12" TextColor="White">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="Сезон: {0} Серия: {1}">
                                                        <Binding Path="LastWatchedSeason"/>
                                                        <Binding Path="LastWatchedSeries"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Button BackgroundColor="Transparent" 
                                        Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference RecentlyChangeCarouselView}}"
                                        CommandParameter="{Binding .}"
                                        Clicked="ItemButtonClicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </StackLayout>

                <!-- Недавно добавленные -->
                <StackLayout x:Name="CAdded">
                <Label Text="Недавно добавленные" Style="{StaticResource SectionTitleStyle}"/>
                <Label Text="Контент, который вы недавно добавили" Style="{StaticResource SectionSubtitleStyle}"/>

                <CollectionView x:Name="RecentlyAddedCarouselView"
                               ItemsSource="{Binding ContentAdded}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedItem}"
                                Margin="0,50,0,50"
                                VerticalOptions="Center"
                                HorizontalOptions="StartAndExpand">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" Span="2"/>
                    </CollectionView.ItemsLayout>


                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource ContentCardStyle}"
                                        Margin="25,10,25,10"
                                        HeightRequest="250"
                                        WidthRequest="200">
                                    <Grid RowDefinitions=".2*,.6*,.2*">
                                        <Image Source="{Binding Image}" Grid.RowSpan="3" Aspect="Fill"/>
                                        <RoundRectangle Grid.RowSpan="3"
                                                        CornerRadius="30"
                                                        HeightRequest="250"
                                                        WidthRequest="200"
                                                        Opacity=".7">
                                            <RoundRectangle.Fill>
                                                <LinearGradientBrush EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="Transparent"/>
                                                    <GradientStop Offset="1" Color="#030005"/>
                                                </LinearGradientBrush>
                                            </RoundRectangle.Fill>
                                        </RoundRectangle>

                                        <VerticalStackLayout Grid.Row="2" Margin="20,-5,0,0">
                                            <Label TextColor="White" Text="{Binding Type, StringFormat='Тип: {0}'}" FontSize="12"/>
                                            <Label FontSize="16" Text="{Binding Title}" TextColor="White"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Button BackgroundColor="Transparent" 
                                        Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference RecentlyAddedCarouselView}}"
                                        CommandParameter="{Binding .}"
                                        Clicked="ItemButtonClicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </StackLayout>

                <!-- Релизы контентов -->
                <StackLayout x:Name="CRelease">
                <Label Text="Что нового?" Style="{StaticResource SectionTitleStyle}"/>
                <Label Text="Последние релизы и предстоящие премьеры вашего контента" Style="{StaticResource SectionSubtitleStyle}"/>

                <CollectionView x:Name="RecentlyReleaseCarouselView"
                               ItemsSource="{Binding ContentRelease}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedItem}"
                                Margin="0,50,0,50"
                                VerticalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" Span="2"/>
                    </CollectionView.ItemsLayout>


                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource ContentCardStyle}"
                                        Margin="25,10,25,10"
                                        HeightRequest="250"
                                        WidthRequest="200">
                                    <Grid RowDefinitions=".2*,.6*,.2*">
                                        <Image Source="{Binding Image}" Grid.RowSpan="3" Aspect="Fill"/>
                                        <RoundRectangle Grid.RowSpan="3"
                                                        CornerRadius="30"
                                                        HeightRequest="250"
                                                        WidthRequest="200"
                                                        Opacity=".7">
                                            <RoundRectangle.Fill>
                                                <LinearGradientBrush EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="Transparent"/>
                                                    <GradientStop Offset="1" Color="#030005"/>
                                                </LinearGradientBrush>
                                            </RoundRectangle.Fill>
                                        </RoundRectangle>

                                        <VerticalStackLayout Grid.Row="2" Margin="20,-5,0,0">
                                            <Label TextColor="White" Text="{Binding DateRelease, StringFormat='Выход: {0}'}" FontSize="12"/>
                                            <Label FontSize="16" Text="{Binding Title}" TextColor="White"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Button BackgroundColor="Transparent" 
                                        Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference RecentlyReleaseCarouselView}}"
                                        CommandParameter="{Binding .}"
                                        Clicked="ItemButtonClicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </StackLayout>

                <!-- Рекомендованный контент -->
                <StackLayout x:Name="MobilePhoneRec">
                    <Label Text="Рекомендованный контент" Style="{StaticResource SectionTitleStyle}"/>
                    <Label Text="Самое популярное на этой неделе" Style="{StaticResource SectionSubtitleStyle}"/>

                    <CollectionView Margin="0,50,0,50"
                    x:Name="RecentlyRecommendationCarouselView"
                    ItemsSource="{Binding ContentRecommendation}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedItem}"
                                    HorizontalOptions="Center">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Horizontal" Span="4"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border Style="{StaticResource ContentCardStyle}"
                             Margin="25,10,25,10"
                             HeightRequest="250"
                             WidthRequest="200">
                                        <Grid RowDefinitions=".2*,.6*,.2*">
                                            <Image Aspect="Fill" Source="{Binding ImageUrl}" Grid.RowSpan="3"/>
                                            <RoundRectangle Grid.RowSpan="3"
                                             CornerRadius="30"
                                             HeightRequest="250"
                                             WidthRequest="200"
                                             Opacity=".7">
                                                <RoundRectangle.Fill>
                                                    <LinearGradientBrush EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="Transparent"/>
                                                        <GradientStop Offset="1" Color="#030005"/>
                                                    </LinearGradientBrush>
                                                </RoundRectangle.Fill>
                                            </RoundRectangle>

                                            <VerticalStackLayout Grid.Row="2" Margin="10,0,0,0">
                                                <Label FontSize="16" Text="{Binding Title}" TextColor="White"/>
                                                <Label TextColor="White" Text="{Binding Type, StringFormat='Тип: {0}'}" FontSize="10"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Button BackgroundColor="Transparent" 
                             Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference RecentlyRecommendationCarouselView}}"
                             CommandParameter="{Binding .}"
                             Clicked="ItemButtonClickedRecommendation"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <Grid 
                    BackgroundColor="{AppThemeBinding Light= #919191, Dark=Black}"
                    Padding="20"
                   
                    RowDefinitions="Auto,Auto,Auto,Auto">

                     <!--Логотип и название--> 
                    <Label 
                        Grid.ColumnSpan="2"
                        Text="CineChronicle 2025"
                        TextColor = "{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Margin="0,0,0,10"/>

                     <!--Контакты--> 
                    <Label 
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Gmail: cine.chronicle.sup@gmail.com"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>
                    
                    <Label 
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="Telegram: @daler_rowney"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>


                     <!--Креативная строка--> 
                    <Label 
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Text="Твори кино-чудеса вместе с нами! 🎬"
                        FontSize="16"
                        FontAttributes="Italic"
                        HorizontalTextAlignment="Center"
                        Margin="0,10,0,0"/>

                </Grid>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>