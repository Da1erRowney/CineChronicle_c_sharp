<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CineChronicle.Application.AllContentPages"
             x:Class="TestProject.AllContentPage"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             Title="Весь ваш кругозор">
    <ContentPage.Resources>
        <local:CountToSpanConverter x:Key="CountToSpanConverter" />
    </ContentPage.Resources>

    <RefreshView x:Name="RefreshView" RefreshColor="Black" Refreshing="OnRefreshing">
        <Grid  BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

            <Image x:Name="Background" Grid.Row ="1" Source="all.jpg" Aspect="AspectFill" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" Opacity="0.5" />

            <Grid Grid.Row="0" BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <ScrollView>
                <StackLayout Orientation="Vertical" Padding="10">
                    <SearchBar x:Name="searchBar" 
                           Placeholder="Поиск вашего контента..." 
                           FontSize="18"  
                           TextChanged="SearchBar_TextChanged" 
                           HorizontalOptions="CenterAndExpand" 
                           SearchButtonPressed="SearchContent" />

                    <StackLayout x:Name="Sort" Orientation="Vertical" Padding="0" IsVisible="false" Margin="0,25,0,0">
                        <Label  x:Name="SortLabel" Text="" VerticalOptions="Center"  FontAttributes="Bold"  FontSize="20" Margin="15,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ВсеButton_Clicked" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding ContentSort.Count, StringFormat='Общее количество: {0}'}" VerticalOptions="Center" FontSize="16" Margin="15,0,0,0"/>
                        <Label Text="Нажмите, чтобы вернуться назад" VerticalOptions="Center" FontSize="16" Margin="15,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ВсеButton_Clicked" />
                            </Label.GestureRecognizers>
                        </Label>
                        <CollectionView Margin="0,15,0,0" x:Name="SortContentCollectionView" Grid.Row="2" ItemsSource="{Binding ContentSort}" SelectionMode="Single" SelectedItem="{Binding SelectedItem}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"  Span="{Binding ContentSort.Count, Converter={StaticResource CountToSpanConverter}}" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Margin="0,5,5,0" Stroke="black" Grid.RowSpan="3" 
                                            BackgroundColor="Black" 
                                            HeightRequest="250" 
                                            StrokeShape ="RoundRectangle 30,30,30,30" 
                                            StrokeThickness="2" 
                                            WidthRequest="200">
                                            <Grid RowDefinitions=".2*,.6*,.3*">
                                                <Image Aspect="Fill" Source="{Binding Image}" Grid.RowSpan="3" />
                                                <RoundRectangle Grid.RowSpan ="3" CornerRadius ="30" HeightRequest="250" WidthRequest="200" Opacity=".7">
                                                    <RoundRectangle.Fill>
                                                        <LinearGradientBrush EndPoint="0,1">
                                                            <GradientStop Offset="0" Color="Transparent"></GradientStop>
                                                            <GradientStop Offset="1" Color="#030005"></GradientStop>
                                                        </LinearGradientBrush>
                                                    </RoundRectangle.Fill>
                                                </RoundRectangle>
                                                <VerticalStackLayout Grid.Row="2" Margin="20,0,0,0">
                                                    <Label  TextColor= "White" Text="{Binding Type, StringFormat='Тип: {0}'}" FontSize="12" />
                                                    <Label FontSize="16" Text="{Binding Title}" TextColor= "White"/>
                                                    <Label FontSize="12" TextColor="White">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="Сезон: {0} Серия: {1}">
                                                                <Binding Path="LastWatchedSeason" />
                                                                <Binding Path="LastWatchedSeries" />
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <Button  BackgroundColor="Transparent" Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference SortContentCollectionView}}" CommandParameter="{Binding .}"
                        Clicked="ItemButtonClicked"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </StackLayout>

                    <StackLayout x:Name="All" Orientation="Vertical" Padding="0" Margin="0,25,0,0" IsVisible="{Binding IsAllVisible}">
                        <StackLayout Orientation="Horizontal" 
                                Spacing="10"
                                Margin="15,0,0,0"
                                VerticalOptions="Center">
                            <Label 
                                Text="Весь ваш контент!"  
                                FontAttributes="Bold" 
                                VerticalOptions="Center"  
                                FontSize="22"/>

                            <Image Source="{AppThemeBinding Light=angleblack.png, Dark=anglewhite.png}"
                                WidthRequest="25"
                                HeightRequest="25"
                                VerticalOptions="Center"
                                HorizontalOptions="EndAndExpand"/>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CategoryButton_Clicked" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>

                        <Label Text="{Binding ContentAllall, StringFormat='Общее количество: {0}'}" VerticalOptions="Center" FontSize="18" Margin="15,0,0,0"/>
                        <CollectionView Margin="0,25,0,0"  x:Name="AllContentCollectionView" Grid.Row="2" ItemsSource="{Binding ContentAll}" SelectionMode="Single" SelectedItem="{Binding SelectedItem}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Horizontal"  Span="{Binding ContentAll.Count, Converter={StaticResource CountToSpanConverter}}" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Margin="0,5,5,0" Stroke="black" Grid.RowSpan="3" 
                                        BackgroundColor="Black" 
                                        HeightRequest="200" 
                                        StrokeShape ="RoundRectangle 30,30,30,30" 
                                        StrokeThickness="3" 
                                        WidthRequest="150">
                                            <Grid RowDefinitions=".2*,.6*,.3*">
                                                <Image Aspect="Fill" Source="{Binding Image}" Grid.RowSpan="3" />
                                                <RoundRectangle Grid.RowSpan ="3" CornerRadius ="30" HeightRequest="200" WidthRequest="150" Opacity=".7">
                                                    <RoundRectangle.Fill>
                                                        <LinearGradientBrush EndPoint="0,1">
                                                            <GradientStop Offset="0" Color="Transparent"></GradientStop>
                                                            <GradientStop Offset="1" Color="#030005"></GradientStop>
                                                        </LinearGradientBrush>
                                                    </RoundRectangle.Fill>
                                                </RoundRectangle>
                                                <VerticalStackLayout Grid.Row="2" Margin="15,0,0,10">
                                                    <Label FontSize="14" Text="{Binding Title}" TextColor= "White"/>
                                                    <Label FontSize="10" TextColor="White">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="Сезон: {0} Серия: {1}">
                                                                <Binding Path="LastWatchedSeason" />
                                                                <Binding Path="LastWatchedSeries" />
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <Button  BackgroundColor="Transparent" Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={x:Reference AllContentCollectionView}}" CommandParameter="{Binding .}"
                                        Clicked="ItemButtonClicked"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

