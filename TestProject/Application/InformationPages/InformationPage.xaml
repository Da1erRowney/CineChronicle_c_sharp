<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestProject.InformationPage"
             Title="{Binding User.NickName}">
    
    <ContentPage.Resources>
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4285F4" Offset="0"/>
            <GradientStop Color="{AppThemeBinding Light=White, Dark=Black}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4285F4" Offset="0"/>
            <GradientStop Color="{AppThemeBinding Light=White, Dark=Black}" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Resources>
    
    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

        <!-- Фон с эффектом размытия -->
        <Image Source="gradientfive.jpg" 
               Aspect="AspectFill"
               x:Name="Background"
               Opacity="0.3">
        </Image>

        <ScrollView Padding="20,10">
            <StackLayout Spacing="30">
                <!-- Заголовок -->
                <StackLayout Spacing="5">
                    <Label Text="Предания Странствующего..." 
                           FontAttributes="Bold" 
                           FontSize="28"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Label Text="Информация о вашем аккаунте" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                </StackLayout>

                <!-- Блок профиля -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                        Padding="25"
                        HorizontalOptions="Center"
                        WidthRequest="400">

                    <StackLayout Spacing="15" HorizontalOptions="Center">
                        <!-- Аватар -->
                        <Frame HasShadow="True" 
                               CornerRadius="50" 
                               HeightRequest="100" 
                               WidthRequest="100"
                               Padding="0"
                               BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}">
                            <Image Aspect="AspectFill" 
                                   Source="{Binding User.NameIcon}"
                                   WidthRequest="100" 
                                   HeightRequest="100">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvatarTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Frame>

                        <!-- Информация -->
                        <StackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Аккаунт пользователя" 
                                   FontSize="16"
                                   TextColor="Gray"/>

                            <Label Text="{Binding User.NickName}"  HorizontalOptions="Center"
                                   FontSize="20"
                                   x:Name="NicknameUserLabel"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </StackLayout>

                        <!-- Кнопки -->
                        <StackLayout Spacing="10" WidthRequest="200">
                            <Button Text="Сменить аккаунт" 
                                    BackgroundColor="#4285F4"
                                    TextColor="White"
                                    x:Name="ButtonAuth"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="AuthButton_Clicked"/>
                            
                            <Button Text="Редактировать данные" 
                                    BackgroundColor="#4285F4"
                                    TextColor="White"
                                    x:Name="ButtonChange"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="ChangeUserDataButton_Clicked"/>

                            <Button Text="Выйти из аккаунта" 
                                    BackgroundColor="Transparent"
                                    TextColor="#4285F4"
                                    BorderColor="#4285F4"
                                    x:Name="ButtonExit"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="ExitAccountButton_Clicked"
                                    IsVisible="False"/>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Информационный блок -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                        Padding="25">

                    <StackLayout Spacing="20">
                        <Label Text="Ваша информация" 
                               FontAttributes="Bold" 
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <!-- Сообщение для неавторизованных -->
                        <StackLayout x:Name="NoteAuthAccountLayout" 
                                     IsVisible="false"
                                     Spacing="15"
                                     BackgroundColor="{AppThemeBinding Light=#FFF9F2, Dark=#2A2118}"
                                     Padding="15">

                            <Label Text="🔒 Требуется авторизация" 
                                   FontAttributes="Bold" 
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light=#E65100, Dark=#FFA726}"/>

                            <Label Text="Полная информация об аккаунте доступна только авторизованным пользователям. Пожалуйста, выполните вход или зарегистрируйтесь."
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"/>
                        </StackLayout>

                        <!-- Основная информация -->
                        <StackLayout x:Name="InformationBlock" 
                                     IsVisible="False"
                                     Spacing="15">
                            
                            <!--Общая статистика (Статусы просмотра и количество всего)-->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="15"
                                    Background="{StaticResource RedGradient}">
                                <StackLayout Spacing="8">
                                    <Label Text="📊 Общая статистика"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=#2C3E50, Dark=#ECF0F1}"/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*" RowSpacing="10">
                                        
                                        <!-- 1 строка -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                                Text="Всего контента:"
                                                FontAttributes="Italic"/>
                                        <Label Grid.Row="0" Grid.Column="1"
                                                Text="{Binding TotalContentCount}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>

                                        <!-- 2 строка -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                                Text="Просмотрено:"
                                                FontAttributes="Italic"/>
                                        <Label Grid.Row="1" Grid.Column="1"
                                                Text="{Binding WatchedCount}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        
                                        <!-- 3 строка -->
                                        <Label Grid.Row="2" Grid.Column="0"
                                                Text="Смотрите:"
                                                FontAttributes="Italic"/>
                                       <Label Grid.Row="2" Grid.Column="1"
                                                Text="{Binding WatchNowCount}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        
                                        <!-- 4 строка -->
                                        <Label Grid.Row="3" Grid.Column="0"
                                                Text="Не начато:"
                                                FontAttributes="Italic"/>
                                        <Label Grid.Row="3" Grid.Column="1"
                                                Text="{Binding NotStartedCount}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </Border>
                            
                            <!--По категориям (Количество в каждой категории)-->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="15"
                                    Background="{StaticResource BlueGradient}">
                                <StackLayout Spacing="8">
                                    <Label Text="🎬 По категориям"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*,*" RowSpacing="10">
                                        <!-- 1 строка -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="Фильмы:"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding MoviesCount}"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"/>

                                        <!-- 2 строка -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="Сериалы:"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="1" Grid.Column="1"
                                                Text="{Binding SeriesCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>

                                        <!-- 3 строка -->
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Text="Аниме:"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="2" Grid.Column="1"
                                                Text="{Binding AnimeCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        
                                        <!-- 4 строка -->
                                        <Label Grid.Row="3" Grid.Column="0"
                                                Text="Дорамы:"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="3" Grid.Column="1"
                                                Text="{Binding DoramaCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        
                                        <!-- 5 строка -->
                                        <Label Grid.Row="4" Grid.Column="0"
                                                Text="Прочее:"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="4" Grid.Column="1"
                                                Text="{Binding OtherCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        
                                        <!-- 6 строка -->
                                        <Label Grid.Row="5" Grid.Column="0"
                                                Text="Мультсериалы:"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="5" Grid.Column="1"
                                                Text="{Binding CartoonCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                        <!-- 7 строка -->
                                        <Label Grid.Row="6" Grid.Column="0"
                                                Text="Документалки:"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="6" Grid.Column="1"
                                                Text="{Binding DocumentalCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </Border>
                            
                            <!-- Статус контента (Активные и завершенные)-->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="15"
                                    Background="{StaticResource RedGradient}">
                                <StackLayout Spacing="8">
                                    <Label Text="📡 Статус контента"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="10">
                                        <!-- 1 строка -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                                Text="Активные релизы:"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="0" Grid.Column="1"
                                                Text="{Binding OngoingContentCount}"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>

                                        <!-- 2 строка -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                                Text="Завершённые:"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Grid.Row="1" Grid.Column="1"
                                                Text="{Binding CompletedContentCount}"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </Border>

                            <!-- Предпочтения (Озвучка и любимый киноматограф) -->
                            <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="15"
                                Background="{StaticResource BlueGradient}">
                                <StackLayout Spacing="8">
                                    <Label Text="❤️ Ваши предпочтения"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=#2C3E50, Dark=#ECF0F1}"/>

                                    <Label Text="Часто выбираемая озвучка:"
                                            FontAttributes="Italic"/>
                                    <Label Text="{Binding PreferredVoiceOver}"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                    <Label Text="Любимый киноматограф:"
                                            FontAttributes="Italic"
                                            Margin="0,10,0,0"/>
                                    <Label Text="{Binding FavoriteGenre}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                            TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                </StackLayout>
                            </Border>
                            
                        </StackLayout>

                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>