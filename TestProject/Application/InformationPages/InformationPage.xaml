<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestProject.InformationPage"
             Title="{Binding User.NickName}">

    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

        <!-- Фон с эффектом размытия -->
        <Image Source="gradientfive.jpg" 
               Aspect="AspectFill"
               x:Name="Background"
               Opacity="0.3">
        </Image>

        <ScrollView Padding="20,10">
            <StackLayout Spacing="30">
                <!-- Заголовок -->
                <StackLayout Spacing="5">
                    <Label Text="Предания Странствующего..." 
                           FontAttributes="Bold" 
                           FontSize="28"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Label Text="Информация о вашем аккаунте" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                </StackLayout>

                <!-- Блок профиля -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                        Padding="25"
                        HorizontalOptions="Center"
                        WidthRequest="400">

                    <StackLayout Spacing="15" HorizontalOptions="Center">
                        <!-- Аватар -->
                        <Frame HasShadow="True" 
                               CornerRadius="50" 
                               HeightRequest="100" 
                               WidthRequest="100"
                               Padding="0"
                               BorderColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}">
                            <Image Aspect="AspectFill" 
                                   Source="{Binding User.NameIcon}"
                                   WidthRequest="100" 
                                   HeightRequest="100">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvatarTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Frame>

                        <!-- Информация -->
                        <StackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Аккаунт пользователя" 
                                   FontSize="16"
                                   TextColor="Gray"/>

                            <Label Text="{Binding User.NickName}"  HorizontalOptions="Center"
                                   FontSize="20"
                                   x:Name="NicknameUserLabel"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </StackLayout>

                        <!-- Кнопки -->
                        <StackLayout Spacing="10" WidthRequest="200">
                            <Button Text="Сменить аккаунт" 
                                    BackgroundColor="#4285F4"
                                    TextColor="White"
                                    x:Name="ButtonAuth"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="AuthButton_Clicked"/>
                            
                            <Button Text="Редактировать данные" 
                                    BackgroundColor="#4285F4"
                                    TextColor="White"
                                    x:Name="ButtonChange"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="ChangeUserDataButton_Clicked"/>

                            <Button Text="Выйти из аккаунта" 
                                    BackgroundColor="Transparent"
                                    TextColor="#4285F4"
                                    BorderColor="#4285F4"
                                    x:Name="ButtonExit"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="16"
                                    Clicked="ExitAccountButton_Clicked"
                                    IsVisible="False"/>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Информационный блок -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                        Padding="25">

                    <StackLayout Spacing="20">
                        <Label Text="Ваша информация" 
                               FontAttributes="Bold" 
                               FontSize="24"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <!-- Сообщение для неавторизованных -->
                        <StackLayout x:Name="NoteAuthAccountLayout" 
                                     IsVisible="false"
                                     Spacing="15"
                                     BackgroundColor="{AppThemeBinding Light=#FFF9F2, Dark=#2A2118}"
                                     Padding="15">

                            <Label Text="🔒 Требуется авторизация" 
                                   FontAttributes="Bold" 
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light=#E65100, Dark=#FFA726}"/>

                            <Label Text="Полная информация об аккаунте доступна только авторизованным пользователям. Пожалуйста, выполните вход или зарегистрируйтесь."
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"/>
                        </StackLayout>

                        <!-- Основная информация -->
                        <StackLayout x:Name="InformationBlock" 
                                     IsVisible="False"
                                     Spacing="15">
                            <!-- Здесь будут динамические элементы информации -->
                        </StackLayout>
                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>