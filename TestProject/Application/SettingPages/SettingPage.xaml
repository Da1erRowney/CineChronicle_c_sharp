<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestProject.SettingPage"
             Title="Настройки">

    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
        <!-- Фон с эффектом размытия -->
        <Image Source="gradientfive.jpg" 
               Aspect="AspectFill" 
               Opacity="0.3"
               x:Name="Background">
        </Image>

        <ScrollView Padding="20,10">
            <StackLayout Spacing="25">
                <!-- Заголовок -->
                <StackLayout Spacing="5">
                    <Label Text="Ваши настройки" 
                           FontAttributes="Bold" 
                           FontSize="28"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Label Text="Настройте приложение под себя" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=Black, Dark=#AAAAAA}"/>
                </StackLayout>

                <!-- Настройка темы -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="20">
                    <StackLayout Spacing="15">
                        <StackLayout Orientation="Horizontal" 
                                    HorizontalOptions="FillAndExpand">
                            <Label Text="Цветовая тема" 
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   VerticalOptions="Center"/>

                            <Switch x:Name="ThemeSwitch" 
                                    HorizontalOptions="End"
                                    OnColor="#4285F4"
                                    ThumbColor="{AppThemeBinding Light=#333333, Dark=White}"
                                    Toggled="OnThemeToggled"/>
                        </StackLayout>

                        <Label Text="Выберите светлую или тёмную тему приложения. Рекомендуем тёмную тему для вечернего просмотра."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </StackLayout>
                </Border>

                <!-- Настройка видео -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="20">
                    <StackLayout Spacing="15">
                        <StackLayout Orientation="Horizontal" 
                                    HorizontalOptions="FillAndExpand">
                            <Label Text="Видео-ролики" 
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   VerticalOptions="Center"/>

                            <Switch x:Name="VideoSwitch" 
                                    HorizontalOptions="End"
                                    OnColor="#4285F4"
                                    ThumbColor="{AppThemeBinding Light=#333333, Dark=White}"
                                    IsToggled="True"
                                    Toggled="OnVideoToggled"/>
                        </StackLayout>

                        <Label Text="Включите для отображения видео-роликов на страницах контента. При отключении будут показываться только постеры."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </StackLayout>
                </Border>

                <!-- Информация о версии -->
                <Label Text="Версия приложения 1.0.0" 
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       HorizontalOptions="Center"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>