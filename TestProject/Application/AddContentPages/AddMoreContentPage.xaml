<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="TestProject.AddMoreContentPage"
             Title="Добавление контента">

    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">
        <!-- Фон с эффектом размытия -->
        <Image Source="gradientfive.jpg" 
               Aspect="AspectFill" 
               Opacity="0.3"
               x:Name="Background">
        </Image>

        <ScrollView Padding="20,10">
            <StackLayout Spacing="25">
                <!-- Заголовок -->
                <StackLayout Spacing="5">
                    <Label Text="На пути к успеху..." 
                           FontAttributes="Bold" 
                           FontSize="28"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Label Text="Добавьте свой контент" 
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#33333, Dark=#AAAAAA}"/>
                </StackLayout>

                <!-- Форма добавления -->
                <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                        Padding="25">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="15"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">

                        <!-- Заголовок формы -->
                        <Label Text="Добавление контента" 
                               FontAttributes="Bold" 
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               Grid.ColumnSpan="3"
                               Margin="0,0,0,10"/>

                        <!-- Название -->
                        <Label Text="Название:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="1"/>

                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <Entry Placeholder="Введите название" 
                                   x:Name="TitleEntry"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="Gray"
                                   ClearButtonVisibility="WhileEditing"/>
                        </Border>

                        <!-- Тип контента -->
                        <Label Text="Тип:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="2"/>

                        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <Picker Title="Выберите тип"
                                   x:Name="TypePicker"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   TitleColor="Gray"
                                   SelectedIndexChanged="TypePicker_SelectedIndexChanged">
                                <Picker.Items>
                                    <x:String>Сериал</x:String>
                                    <x:String>Аниме</x:String>
                                    <x:String>Мультсериал</x:String>
                                    <x:String>Фильм</x:String>
                                    <x:String>Дорама</x:String>
                                    <x:String>Документальный</x:String>
                                    <x:String>Прочее</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <!-- Озвучка -->
                        <Label Text="Озвучка:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="3"/>

                        <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <Entry Placeholder="Введите озвучку" 
                                   x:Name="DubbingEntry"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="Gray"/>
                        </Border>

                        <!-- Серия и сезон -->
                        <Label Text="Прогресс:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="4"/>

                        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="EntrySeriaGrid"
                              ColumnDefinitions="*,10,*"
                              ColumnSpacing="5">

                            <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                                    Grid.Column="2">
                                <Entry Placeholder="Сезон" 
                                       x:Name="LastWatchedSeasonEntry"
                                       Keyboard="Numeric"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       PlaceholderColor="Gray"/>
                            </Border>
                            <Label Text="/" 
                                    FontSize="16"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Grid.Column="1"/>
                            <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                                <Entry Placeholder="Серия" 
                                       x:Name="LastWatchedSeriesEntry"
                                       Keyboard="Numeric"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       PlaceholderColor="Gray"/>
                            </Border>

                          

                        </Grid>

                        <!-- Ссылка -->
                        <Label Text="Ссылка:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="5"/>

                        <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <Entry Placeholder="https://example.com" 
                                   x:Name="LinkEntry"
                                   Keyboard="Url"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="Gray"/>
                        </Border>

                        <!-- Статус -->
                        <Label Text="Статус:" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                               VerticalOptions="Center"
                               Grid.Row="6"/>

                        <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <Picker Title="Выберите статус"
                                   x:Name="WatchStatusPicker"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   TitleColor="Gray">
                                <Picker.Items>
                                    <x:String>Просмотрено</x:String>
                                    <x:String>Смотрю</x:String>
                                    <x:String>Не начинал</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </Grid>
                </Border>

                <!-- Кнопка сохранения -->
                <Button Text="Сохранить" 
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#4285F4"
                        CornerRadius="10"
                        HeightRequest="50"
                        WidthRequest="200"
                        HorizontalOptions="Center"
                        Margin="0,15"
                        Clicked="OnAddClicked"/>
            </StackLayout>
        </ScrollView>

        <!-- Overlay и анимация -->
        <BoxView x:Name="Overlay"
                 BackgroundColor="#80000000"
                 Opacity="0"
                 IsVisible="False"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All"/>

        <skia:SKLottieView x:Name="SavingAnimation"
                           Source="loading_animation.json"
                           RepeatCount="-1"
                           IsVisible="False"
                           WidthRequest="150"
                           HeightRequest="150"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>